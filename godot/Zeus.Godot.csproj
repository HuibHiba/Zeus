<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Zeus.Godot</RootNamespace>
    <AssemblyName>Zeus.Godot</AssemblyName>
  </PropertyGroup>
  <!-- Testhaken (AutoTest.cs, ZEUS_AUTOTEST) alleen in editor- en debugbuilds; de release-export (ExportRelease) bevat ze niet. -->
  <PropertyGroup Condition="'$(Configuration)' != 'ExportRelease'">
    <DefineConstants>$(DefineConstants);ZEUS_TESTHOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="AutoTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="..\sim\Zeus.Sim\Zeus.Sim.csproj" />
  </ItemGroup>
</Project>
