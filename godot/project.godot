; Engine configuration file (Zeus online, display project)
config_version=5

[application]

config/name="Gaffer's Notebook"
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="GaffersNotebook"
run/main_scene="res://Menu.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1520
window/size/viewport_height=780
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

AudioManager="*res://AudioManager.cs"
Hotkeys="*res://Hotkeys.cs"

[dotnet]

project/assembly_name="Zeus.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
