[
 "# Vrienden (ladder zonder server): opslaan ingeschakeld, wedstrijd met vaste seed per ronde, duplicaat geweigerd, overlay heropenen en opgeslagen ladder laden.",
 "env ZEUS_NOSAVE=",
 "expect_node #Cover",
 "key Space",
 "click Skip tour",
 "click Friends",
 "expect_text FRIENDS",
 "expect_text No results yet.",
 "wait 0.3s",
 "shot 01_friends_empty",
 "click Play ladder match",
 "timeout 120",
 "expect_text Copy the result code",
 "timeout 5",
 "wait 0.3s",
 "shot 02_played",
 "click Copy result code",
 "expect_text Result code copied.",
 "click Paste result code",
 "expect_text already in the ladder",
 "wait 0.3s",
 "shot 03_duplicate_rejected",
 "click Back",
 "expect_node #Menu",
 "click Friends",
 "expect_text !No results yet.",
 "click Back",
 "quit"
]
